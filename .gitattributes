# Normalise line endings to LF in the repo
* text=auto eol=lf

# Deck and docs: text, with HTML-aware diff hunk headers
*.html text diff=html
*.md   text
*.css  text
*.js   text

# Binary assets: never diff or merge as text
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.key   binary
*.pptx  binary
